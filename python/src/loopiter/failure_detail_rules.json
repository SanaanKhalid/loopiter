{
  "inputMax": 32768,
  "outputMax": 500,
  "rules": [
    {
      "pattern": "https?:\\/\\/[^\\s\"'<>]+",
      "flags": "gi",
      "replace": "[redacted]"
    },
    {
      "pattern": "\\b([A-Za-z][A-Za-z0-9+.-]{0,31}:\\/\\/)(?=[^\\s/@]*:)([^\\s/@]+)@",
      "flags": "g",
      "replace": "$1[redacted]@"
    },
    {
      "pattern": "\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b",
      "flags": "g",
      "replace": "[redacted]"
    },
    {
      "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
      "flags": "g",
      "replace": "[redacted]"
    },
    {
      "pattern": "\\bBearer\\s+\\S+",
      "flags": "gi",
      "replace": "Bearer [redacted]"
    },
    {
      "pattern": "\\bsk-[A-Za-z0-9._~+/-]{8,}",
      "flags": "gi",
      "replace": "[redacted]"
    },
    {
      "pattern": "\\bAIza[0-9A-Za-z_-]{20,}",
      "flags": "g",
      "replace": "[redacted]"
    },
    {
      "pattern": "\\bxoxb-[0-9A-Za-z-]{10,}",
      "flags": "g",
      "replace": "[redacted]"
    },
    {
      "pattern": "(?<![A-Za-z0-9_])\\\\?[\"']?(?:[A-Za-z]{1,20}-)?authorization\\\\?[\"']?\\s*(?:=|:|%253d|%253a|%3d|%3a)\\s*(?:\\\\?\"(?:\\\\.|[^\"\\\\\\n])*\\\\?\"|'[^'\\n]*'|[^\\n]*)",
      "flags": "gi",
      "replace": "[redacted]"
    },
    {
      "pattern": "(?<![A-Za-z_-])\\\\?[\"']?(?:shared[_-]?access[_-]?key|client[_-]?secret|ocp-apim-subscription-key|aws[_-]?secret[_-]?access[_-]?key|x-api-key|subscription-key|refresh[_-]?token|id[_-]?token|access[_-]?token|api[_-]?key|accountkey|pwd)\\\\?[\"']?\\s*(?:=|:|%253d|%253a|%3d|%3a)\\s*\\\\?[\"']?[^\\s\"'&,}\\\\]+",
      "flags": "gi",
      "replace": "[redacted]"
    },
    {
      "pattern": "((?<![A-Za-z0-9_-])\\\\?[\"']?[A-Za-z0-9_-]{0,40}token\\\\?[\"']?\\s{0,8}(?:=|:|%253d|%253a|%3d|%3a)\\s{0,8}\\\\?[\"']?)(?!\\d+(?![^\\s\"'&,}\\\\%]))[^\\s\"'&,}\\\\%]{6,}",
      "flags": "gi",
      "replace": "$1[redacted]"
    },
    {
      "pattern": "([?&]|%3f|%26|%253f|%2526)(code(?:=|%3d|%253d))[^&#\\s\"'%]{8,}",
      "flags": "gi",
      "replace": "$1$2[redacted]"
    },
    {
      "pattern": "((?<![A-Za-z])sig(?:\\s*=\\s*|%253d|%3d))((?:[^%&#\\s]|%(?!26))*)",
      "flags": "gi",
      "replace": "$1[redacted]"
    },
    {
      "pattern": "(?<![A-Za-z0-9.-])(?!platform\\.openai\\.com(?![:/?]))(?:[A-Za-z0-9-]+\\.)+(?:azure-api\\.net|azure\\.(?:com|us|cn)|windows\\.net|openai\\.com)(?![A-Za-z0-9-]|\\.[A-Za-z0-9])",
      "flags": "gi",
      "replace": "[redacted]"
    }
  ]
}

{
  "name": "loopiter",
  "version": "0.3.0-alpha.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanaanKhalid/loopiter.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "description": "A lightweight, model-agnostic feedback loop for production AI systems.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./postgres": {
      "types": "./dist/src/postgres.d.ts",
      "import": "./dist/src/postgres.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "import": "./dist/src/testing.js"
    }
  },
  "bin": {
    "loopiter": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "SUPPORTED.md",
    "docs/migration.md",
    "docs/autonomy-migration.md",
    "docs/autonomy-release-checklist.md",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "starter": "npm run build && node dist/examples/prompt-improvement/cli.js",
    "test:postgres": "npm run build && node --test dist/test/postgres.test.js",
    "test:mock-support": "npm run build && node scripts/mock-support.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "test:docs": "node scripts/check-docs.mjs",
    "test:fern": "node scripts/check-fern.mjs",
    "benchmark": "npm run build && node dist/examples/benchmark.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "example:capture": "npm run build && node dist/examples/feedback-capture.js",
    "example:self-improving": "npm run build && node dist/examples/self-improving-agent.js"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "pg": "^8.16.0",
    "typescript": "^5.9.0"
  }
}
